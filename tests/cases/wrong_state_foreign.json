{
 "note": "a member's own file appears at .file-organizer/state.json: survey refuses to overwrite it, and the verdict says so",
 "task": "organize-folder",
 "arguments": {
  "folder": "Downloads"
 },
 "agent_folder": "folders/plain.tar.gz",
 "steps": [
