{
  "task": "organize",
  "arguments": {
    "seed": 2,
    "size": "large"
  },
  "steps": [
    {
      "tool": "unpack_inbox",
      "arguments": {
        "seed": 2,
        "size": "large"
      },
      "save_as": "start"
    },
    {
      "tool": "read_rules",
      "arguments": {}
    },
    {
      "tool": "inventory",
      "arguments": {
        "root": "$ref:start.root",
        "offset": 0,
        "limit": 100
      },
      "save_as": "inv0"
    },
    {
      "tool": "inventory",
      "arguments": {
        "root": "$ref:start.root",
        "offset": 100,
        "limit": 100
      },
      "save_as": "inv1"
    },
    {
      "tool": "inventory",
      "arguments": {
        "root": "$ref:start.root",
        "offset": 200,
        "limit": 100
      },
      "save_as": "inv2"
    },
    {
      "python": "import importlib.util, sys\nfrom pathlib import Path\nwords = [w for w in sys.argv[1:] if not w.startswith('-')]\ncase = next(Path(w) for w in words if w.endswith('.json')).resolve()\nspec = importlib.util.spec_from_file_location('plan_from_inventory', case.parent / 'plan_from_inventory.py')\nhelper = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(helper)\nfor index, batch in enumerate(helper.harness_plan(outputs, [f'inv{i}' for i in range(3)], 'gold', 3, None)):\n    outputs[f'batch{index}'] = batch\n"
    },
    {
      "tool": "apply_plan",
      "arguments": {
        "root": "$ref:start.root",
        "moves": "$ref:batch0.moves",
        "deletes": "$ref:batch0.deletes"
      },
      "save_as": "applied0"
    },
    {
      "tool": "apply_plan",
      "arguments": {
        "root": "$ref:start.root",
        "moves": "$ref:batch1.moves",
        "deletes": "$ref:batch1.deletes"
      },
      "save_as": "applied1"
    },
    {
      "tool": "apply_plan",
      "arguments": {
        "root": "$ref:start.root",
        "moves": "$ref:batch2.moves",
        "deletes": "$ref:batch2.deletes"
      },
      "save_as": "applied2"
    },
    {
      "tool": "list_tree",
      "arguments": {
        "root": "$ref:start.root",
        "max_entries": 200
      }
    }
  ],
  "answer": "Deleted every junk, empty and duplicate file and moved every other file to organized/ by the rules.",
  "expect": {
    "valid": true,
    "score_min": 1.0
  }
}
